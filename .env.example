# Режим работы:
#   category  — следить за категорией/поиском (используется WB_URL)
#   watchlist — следить за конкретными артикулами из watchlist.txt
MODE=category

# --- Режим category -----------------------------------------------------------
# Ссылка на catalog/search API нужной категории. Открой категорию на WB,
# в DevTools (F12) → Network найди запрос к catalog.wb.ru/...catalog и
# скопируй его URL сюда. Пример ниже — заглушка, подставь свою категорию.
WB_URL=https://catalog.wb.ru/catalog/<shard>/v4/catalog?appType=1&cat=<id>&curr=rub&dest=-1257786&sort=newly&page=1

# --- Режим watchlist ----------------------------------------------------------
# Файл со списком товаров (см. watchlist.txt.example).
WATCHLIST_FILE=watchlist.txt
# Регион доставки для card-API (dest). -1257786 — Москва/центр.
WB_DEST=-1257786

# --- Telegram -----------------------------------------------------------------
# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
# ID чата/канала, куда слать уведомления (узнать у @userinfobot)
TELEGRAM_CHAT_ID=

# --- Фильтры (только для режима category) -------------------------------------
MIN_DISCOUNT=0
MIN_RATING=0
MAX_PRICE=0

# --- Тайминги -----------------------------------------------------------------
# Пауза между полными проверками категорий, сек.
POLL_INTERVAL=120
# Пауза между проверками watchlist (обычно короче — список товаров небольшой,
# хочется узнавать о падении цены быстрее).
WATCHLIST_POLL_INTERVAL=20
# Пауза после ответа 429 (rate limit), сек.
RATE_LIMIT_BACKOFF=120
